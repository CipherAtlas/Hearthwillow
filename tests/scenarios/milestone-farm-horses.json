{
  "name": "Foraging, pasture feeding and horse riding",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "assert": "get_viewport().get_texture().get_size()==Vector2(1920,1080)"
    },
    {
      "assert": "get_tree().root.size.x>=1918 and get_tree().root.size.y>=1079",
      "message": "1080p display window; allow the macOS one-pixel window frame, never a 720p override."
    },
    {
      "eval": "get_node('VillageLife').set_meta('forage_fixture',{'apples':get_node('VillageLife').apples,'crumbs':get_node('VillageLife').crumbs,'owl_treats':get_node('VillageLife').owl_treats})"
    },
    {
      "eval": "get_node('VillageLife').set('apples',0)"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "enter_game",
        "args": [
          false
        ]
      }
    },
    {
      "set": {
        "path": "Village/Actors/hedgehog-1",
        "props": {
          "chatting": 30,
          "action": "idle"
        }
      }
    },
    {
      "eval": "get_node('Player').set('position',get_node('Village/Actors/hedgehog-1').position+Vector3(0,0,1.4))"
    },
    {
      "call": {
        "path": "Player",
        "method": "reset_physics_interpolation"
      }
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.3
    },
    {
      "assert": "get_node('VillageLife').nearest.actor_id == 'hedgehog-1'"
    },
    {
      "input": [
        {
          "action": "bread",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageLife').apples == 1"
    },
    {
      "input": [
        {
          "action": "bread",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageLife').apples == 1",
