{
  "name": "Four bridge crossings",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "assert": "get_viewport().get_texture().get_size()==Vector2(1920,1080)"
    },
    {
      "assert": "get_tree().root.size.x>=1918 and get_tree().root.size.y>=1079",
      "message": "1080p display window; allow the macOS one-pixel window frame, never a 720p override."
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "enter_game",
        "args": [
          false
        ]
      }
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(-17.533896,3.0)))"
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ],
          "controls_blocked": false
        }
      }
    },
    {
      "set": {
        "path": "CameraRig",
        "props": {
          "rotation": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.2
    },
    {
      "input": [
        {
          "action": "dash",
          "pressed": true
        },
        {
          "action": "move_right",
          "hold": 2.6
        },
        {
          "action": "dash",
          "pressed": false
        }
      ]
    },
    {
      "wait": 0.2
    },
    {
      "assert": "(get_node('Player').position.x--10.533896)*cos(0.0)-(get_node('Player').position.z-3)*sin(0.0) > 5.5",
      "message": "Traverse bridge through its actual deck and bank openings"
    },
    {
      "assert": "get_node('Player').is_on_floor()",
      "message": "Remain grounded after crossing"
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(51.0,42.0)))"
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ],
          "controls_blocked": false
        }
      }
    },
    {
      "set": {
