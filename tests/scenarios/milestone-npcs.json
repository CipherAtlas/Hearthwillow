{
  "name": "Local residents, dogs, owls and dove feeding",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "assert": "get_viewport().get_texture().get_size()==Vector2(1920,1080)"
    },
    {
      "assert": "get_tree().root.size.x>=1918 and get_tree().root.size.y>=1079",
      "message": "1080p display window; allow the macOS one-pixel window frame, never a 720p override."
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "enter_game",
        "args": [
          false
        ]
      }
    },
    {
      "set": {
        "path": "CameraRig",
        "props": {
          "desired_yaw": 0,
          "desired_pitch": 0.15,
          "distance": 3.8
        }
      }
    },
    {
      "eval": "get_node('Village/Actors/pip').set('chatting',30)"
    },
    {
      "eval": "get_node('Player').set('position',get_node('Village/Actors/pip').position+Vector3(0,0,1.4))"
    },
    {
      "call": {
        "path": "Player",
        "method": "reset_physics_interpolation"
      }
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.35
    },
    {
      "assert": "get_node('VillageLife').nearest.actor_id == 'pip'"
    },
    {
      "input": [
        {
          "action": "talk",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('HUD/Speech/Resident0/Content/Line').text.contains('heart-shaped leaf')",
      "message": "Pip speaks the original dialogue"
    },
    {
      "wait": 0.12
    },
    {
      "assert": "get_node('HUD/Speech/Resident0').visible",
      "message": "Pip actual overhead panel appears"
    },
    {
      "assert": "abs(get_node('HUD/Speech/Resident0').size.x-290) < .1",
      "message": "Published desktop width retained"
    },
    {
      "input": [
        {
          "action": "companion",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('Village/Actors/pip').following",
      "message": "Pip accepts a companion invitation"
    },
    {
      "input": [
        {
          "action": "move_forward",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.8
    },
    {
      "assert": "get_node('Village/Actors/pip').distance_walked > .2",
      "message": "Invited companion walks"
    },
    {
      "input": [
        {
          "action": "companion",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "not get_node('Village/Actors/pip').following",
      "message": "Companion can be dismissed"
    },
    {
      "eval": "get_node('Village/Actors/puppy-mochi').set('chatting',30)"
    },
    {
      "eval": "get_node('Player').set('position',get_node('Village/Actors/puppy-mochi').position+Vector3(0,0,1.4))"
    },
    {
      "call": {
        "path": "Player",
        "method": "reset_physics_interpolation"
      }
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.35
    },
    {
      "assert": "get_node('VillageLife').nearest.actor_id == 'puppy-mochi'"
    },
    {
      "input": [
        {
          "action": "interact",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').action == 'pet'",
      "message": "Dog responds to petting"
    },
    {
      "input": [
        {
          "action": "puppy_sit",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('sit')",
      "message": "Original dog sit animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_dance",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('dance')",
      "message": "Original dog dance animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_spin",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('spin')",
      "message": "Original dog spin animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_bow",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('bow')",
      "message": "Original dog bow animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_wave",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('wave')",
      "message": "Original dog wave animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_roll",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').animation_player.current_animation.ends_with('roll')",
      "message": "Original dog roll animation plays"
    },
    {
      "input": [
        {
          "action": "puppy_follow",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('Village/Actors/puppy-mochi').following",
      "message": "Dog follows"
    },
    {
      "input": [
        {
          "action": "puppy_home",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "not get_node('Village/Actors/puppy-mochi').following and get_node('Village/Actors/puppy-mochi').waypoint == 0",
      "message": "Dog heads back to its home route"
    },
    {
      "eval": "get_node('Village/Actors/owl-brown-1').set('chatting',30)"
    },
    {
      "eval": "get_node('Player').set('position',get_node('Village/Actors/owl-brown-1').position+Vector3(0,0,1.4))"
    },
    {
      "call": {
        "path": "Player",
        "method": "reset_physics_interpolation"
      }
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.35
    },
    {
      "assert": "get_node('VillageLife').nearest.actor_id == 'owl-brown-1'"
    },
    {
      "input": [
        {
          "action": "bread",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageLife').owl_treats == 3",
      "message": "Treats remain reachable beside the owls"
    },
    {
      "input": [
        {
          "action": "talk",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('VillageLife').owl_treats == 2 and get_node('Village/Actors/owl-brown-1').animation_player.current_animation.ends_with('feed')",
      "message": "Owl consumes one treat and plays feeding animation"
    },
    {
      "input": [
        {
          "action": "talk",
          "hold": 0.05
        }
      ]
    },
    {
      "input": [
        {
          "action": "interact",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageLife').owl_treats == 2 and get_node('Village/Actors/owl-brown-1').action == 'eat'",
      "message": "Repeated actions cannot consume extra food or interrupt the meal"
    },
    {
      "eval": "get_node('Village/Actors/maple').set('chatting',30)"
    },
    {
      "eval": "get_node('Player').set('position',get_node('Village/Actors/maple').position+Vector3(0,0,1.4))"
    },
    {
      "call": {
        "path": "Player",
        "method": "reset_physics_interpolation"
      }
    },
    {
      "set": {
        "path": "Player",
        "props": {
          "velocity": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "wait": 0.35
    },
    {
      "assert": "get_node('VillageLife').nearest.actor_id == 'maple'"
    },
    {
      "input": [
        {
          "action": "bread",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageLife').crumbs == 1",
      "message": "Maple gives crumbs"
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(-37,4)))"
    },
    {
      "set": {
        "path": "VillageFlock",
        "props": {
          "flight": false,
          "age": 1
        }
      }
    },
    {
      "wait": 0.35
    },
    {
      "input": [
        {
          "action": "interact",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('VillageSeating').seated.get('id','')=='bird-clearing-bench'"
    },
    {
      "input": [
        {
          "action": "talk",
          "hold": 0.05
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('VillageLife').crumbs == 0 and get_node('VillageFlock').served and get_node('VillageFlock').status == 'eating'",
      "message": "Flock eats offered crumbs"
    },
    {
      "assert": "get_node('VillageFlock/Crumbs').visible",
      "message": "Serving appears"
    },
    {
      "set": {
        "path": "VillageFlock",
        "props": {
          "meal_age": 4.2
        }
      }
    },
    {
      "wait": 0.2
    },
    {
      "assert": "get_node('VillageFlock').status == 'happy'",
      "message": "Fed flock becomes happy"
    },
    {
      "set": {
        "path": "VillageFlock",
        "props": {
          "meal_age": 10.1
        }
      }
    },
    {
      "wait": 0.2
    },
    {
      "assert": "get_node('VillageFlock').flight and not get_node('VillageFlock').served",
      "message": "Flock takes off after its meal"
    },
    {
      "eval": "get_node('VillageSeating').leave()"
    },
    {
      "assert_no_errors": true
    }
  ]
}