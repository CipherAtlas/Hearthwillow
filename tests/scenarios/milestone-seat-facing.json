{
  "name": "Both directions on all swings and picnic cushions at 1080p",
  "scene": "main",
  "keep_running": true,
  "steps": [
    {
      "eval": "get_node('HUD/Menus').enter_game(false)"
    },
    {
      "assert": "get_viewport().get_visible_rect().size==Vector2(1920,1080)"
    },
    {
      "eval": "set_meta('approach',get_node('VillageSeating').get_node('Swings/sunrise-meadow-swings').find_child('Pivot0',true,false).to_global(Vector3(0,-2.65,0))+Vector3(0,0,1.5).rotated(Vector3(0,1,0),get_node('VillageSeating').get_node('Swings/sunrise-meadow-swings').rotation.y))"
    },
    {
      "eval": "get_node('HUD/VillageMap').travel_point(Vector2(get_meta('approach').x,get_meta('approach').z))"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "action": "interact"
        }
      ]
    },
    {
      "assert": "get_node('VillageSeating').riding==get_node('VillageSeating').get_node('Swings/sunrise-meadow-swings') and get_node('VillageSeating').swing_index==0"
    },
    {
      "assert": "get_node('VillageSeating').facing_sign==-1"
    },
    {
      "assert": "get_node('VillageSeating').panel.get_node('Content/TurnAround').visible"
    },
    {
      "eval": "get_node('VillageSeating').angles.set('sunrise-meadow-swings0',0.0)"
    },
    {
      "eval": "get_node('VillageSeating').speeds.set('sunrise-meadow-swings0',0.0)"
    },
    {
      "input": [
        {
          "action": "move_forward",
          "hold": 0.35
        }
      ]
    },
    {
      "assert": "get_node('VillageSeating').speeds['sunrise-meadow-swings0']*get_node('VillageSeating').facing_sign>0.05"
    },
    {
      "eval": "set_meta('old_yaw',get_node('VillageSeating').facing_yaw)"
    },
    {
      "eval": "set_meta('old_angle',get_node('VillageSeating').angles['sunrise-meadow-swings0'])"
    },
    {
      "input": [
        {
          "click_node": "VillageSeating/UI/Controls/Content/TurnAround"
        }
      ]
    },
    {
      "assert": "get_node('VillageSeating').facing_sign==1"
    },
    {
      "assert": "abs(angle_difference(get_node('VillageSeating').facing_yaw,get_meta('old_yaw')))>3.13"
    },
    {
