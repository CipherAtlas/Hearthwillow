    },
    {
      "assert": "get_node('CameraRig').follow_anchor==get_node('VillageSeating').get_node('Swings/sunrise-meadow-swings').get_node('ViewAnchor')"
    },
    {
      "eval": "get_node('VillageSeating').angles.set('sunrise-meadow-swings0',0.0)"
    },
    {
      "eval": "get_node('VillageSeating').speeds.set('sunrise-meadow-swings0',0.0)"
    },
    {
      "input": [
        {
          "action": "move_forward",
