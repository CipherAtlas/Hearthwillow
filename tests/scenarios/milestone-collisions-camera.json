{
  "name": "Scenery collisions, water boundaries and camera",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "assert": "get_viewport().get_texture().get_size()==Vector2(1920,1080)"
    },
    {
      "assert": "get_tree().root.size.x>=1918 and get_tree().root.size.y>=1079",
      "message": "1080p display window; allow the macOS one-pixel window frame, never a 720p override."
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "enter_game",
        "args": [
          false
        ]
      }
    },
    {
      "wait": 0.4
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(5.8,11)))"
    },
    {
      "eval": "get_node('CameraRig').set('rotation',Vector3(0,0,0))"
    },
    {
      "wait": 0.3
    },
    {
      "input": [
        {
          "action": "move_right",
          "hold": 1.3
        }
      ]
    },
    {
      "assert": "get_node('Player').position.x > 6.8 and get_node('Player').position.x < 7.05",
      "message": "Native cottage collision stops the spirit at the wall, including its radius"
    },
    {
      "assert": "get_node('Player').is_on_floor()",
      "message": "Collision preserves contact with the ground"
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(5.8,11)))"
    },
    {
      "eval": "get_node('CameraRig').set('rotation',Vector3(0,1.5707963,0))"
    },
    {
      "wait": 0.4
    },
    {
      "assert": "get_node('CameraRig').visible_distance <= get_node('CameraRig').clear_distance(get_node('CameraRig').avoidance_yaw)+.02 and get_node('CameraRig').desired_avoidance != 0",
      "message": "Camera eases to a clear side and stays outside the cottage"
    },
    {
      "input": [
        {
          "click": [
            680,
            380
          ],
          "button": "wheel_down"
        }
      ]
    },
    {
      "assert": "get_node('CameraRig').distance > 4.1",
      "message": "Mouse wheel changes camera distance"
    },
    {
      "input": [
        {
          "click": [
            680,
            380
          ]
        }
      ]
    },
    {
      "input": [
        {
          "key": "Escape"
        }
      ]
    },
    {
      "assert": "not get_node('WorldSurface').can_enter(Vector2(-10.533896,18))",
      "message": "Original river is blocked away from bridges"
    },
    {
      "assert": "not get_node('WorldSurface').can_enter(Vector2(54.531793,24.152861))",
      "message": "Moved town brook uses its current curved course"
    },
    {
      "assert": "not get_node('WorldSurface').can_enter(Vector2(-54,-40))",
      "message": "Waterfall stream uses its current placement"
    },
    {
      "assert": "get_node('WorldSurface').data.buildings.size()==15",
      "message": "Map has original transformed cottage and tower footprints"
    },
    {
      "eval": "get_node('Player').set('position',get_node('WorldSurface').recovery_spot(Vector2(.3,20)))"
    },
    {
      "eval": "get_node('CameraRig').set('rotation',Vector3(0,0,0))"
    },
    {
      "input": [
        {
          "action": "glide",
          "hold": 0.05
        },
        {
          "action": "move_forward",
          "hold": 1
        }
      ]
    },
    {
      "assert": "get_node('Player').gliding and get_node('Player').position.z < 16.5",
      "message": "G selects the original 4.5 m/s glide"
    },
    {
      "input": [
        {
          "action": "glide",
          "hold": 0.05
        },
        {
          "click_node": "HUD/VillageMap"
        }
      ]
    },
    {
      "assert": "get_node('HUD/VillageMap').expanded",
      "message": "Map button and keyboard control are equivalent"
    },
    {
      "eval": "get_viewport().get_texture().get_image().save_png('res://evidence/village-map-1080p.png')"
    },
    {
      "input": [
        {
          "key": "Escape"
        },
        {
          "click_node": "HUD/Actions/Buttons/Settings"
        }
      ]
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "toggle_audio"
      }
    },
    {
      "assert": "get_node('VillageSound/Music').playing",
      "message": "Sound button starts original recorded music"
    },
    {
      "wait": 0.5
    },
    {
      "assert": "get_node('VillageSound/Music').get_playback_position() > .25",
      "message": "Audio time advances during actual playback"
    },
    {
      "input": [
        {
          "click_node": "HUD/Actions/Buttons/Settings"
        }
      ]
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "toggle_audio"
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "close_menu"
      }
    },
    {
      "assert_no_errors": true
    }
  ]
}
