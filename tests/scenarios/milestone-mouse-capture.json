{
  "name": "Gameplay captures at spawn; Escape releases; map/settings/basket restore capture",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "wait": 0.3
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "scene.set_meta(\"mouse_mode\",Input.mouse_mode)"
          }
        ]
      }
    },
    {
      "assert": "get_meta(\"mouse_mode\") == 0",
      "message": "Starter has a usable pointer"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "enter_game",
        "args": [
          false
        ]
      }
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "scene.set_meta(\"mouse_mode\",Input.mouse_mode)"
          }
        ]
      }
    },
    {
      "assert": "get_meta(\"mouse_mode\") == 2",
      "message": "Gameplay spawn captures without clicking"
    },
    {
      "eval": "set_meta('yaw_before',get_node('CameraRig').desired_yaw)"
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "var event = InputEventMouseMotion.new()\nevent.relative=Vector2(30,0)\nevent.screen_relative=Vector2(30,0)\nInput.parse_input_event(event)"
          }
        ]
      }
    },
    {
      "wait": 0.1
    },
    {
      "assert": "abs(get_node('CameraRig').desired_yaw-get_meta('yaw_before'))>.01",
      "message": "Captured mouse motion immediately turns the camera"
    },
    {
      "input": [
        {
          "action": "release_mouse",
          "hold": 0.03
        }
      ]
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "scene.set_meta(\"mouse_mode\",Input.mouse_mode)"
          }
        ]
      }
    },
    {
      "assert": "get_meta(\"mouse_mode\") == 0"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "sync_blocking"
      }
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "scene.set_meta(\"mouse_mode\",Input.mouse_mode)"
          }
        ]
      }
    },
    {
      "assert": "get_meta(\"mouse_mode\") == 0",
      "message": "HUD synchronization preserves an explicit Escape release"
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_viewport().warp_mouse(Vector2(700,350))"
    },
    {
      "input": [
        {
          "click": [
            700,
            350
          ]
        }
      ]
    },
    {
      "call": {
        "path": "/root/ForgeRuntime",
        "method": "c_exec",
        "args": [
          {
            "code": "scene.set_meta(\"mouse_mode\",Input.mouse_mode)"
          }
        ]
      }
    },
    {
      "assert": "get_meta(\"mouse_mode\") == 2",
      "message": "Clicking back into world restores capture"
