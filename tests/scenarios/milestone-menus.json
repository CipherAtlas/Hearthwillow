{
  "name": "Starter, live-site HUD, menus, sound and map travel",
  "scene": "res://scenes/main.tscn",
  "keep_running": true,
  "steps": [
    {
      "wait": 0.3
    },
    {
      "assert": "get_tree().root.size.x>=1918 and get_tree().root.size.y>=1079",
      "message": "1080p display window; allow the macOS one-pixel window frame, never a 720p override."
    },
    {
      "assert": "get_viewport().get_texture().get_size() == Vector2(1920,1080)"
    },
    {
      "assert": "get_node('HUD/Menus/Starter').visible and get_node('Player').controls_blocked and get_node('CameraRig').title_screen"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "reset_keys"
      }
    },
    {
      "input": [
        {
          "action": "move_forward",
          "hold": 0.3
        }
      ]
    },
    {
      "assert": "abs(get_node('Player').position.z-20)<.05"
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/Menus/Starter/Content/Menu/Enter').warp_mouse(get_node('HUD/Menus/Starter/Content/Menu/Enter').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "release_all": true
        },
        {
          "click_node": "HUD/Menus/Starter/Content/Menu/Enter"
        }
      ]
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('HUD/Menus').entered and get_node('HUD/Menus/Guide').visible"
    },
    {
      "input": [
        {
          "action": "interact",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "not get_node('Player').controls_blocked"
    },
    {
      "assert": "get_node('HUD/Hints').position==Vector2(36,1024) and get_node('HUD/VillageMap').size==Vector2(190,150)"
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/Actions/Buttons/Settings').warp_mouse(get_node('HUD/Actions/Buttons/Settings').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/Actions/Buttons/Settings"
        }
      ]
    },
    {
      "assert": "get_node('HUD/Menus/Settings').visible and get_node('Player').controls_blocked"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_tab",
        "args": [
          1
        ]
      }
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle').warp_mouse(get_node('HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle"
        }
      ]
    },
    {
      "assert": "get_node('VillageSound').enabled and get_node('VillageSound/Music').playing"
    },
    {
      "set": {
        "path": "HUD/Menus/Settings/Content/Scroll/Pages/Sound/MasterRow/Slider",
        "props": {
          "value": 0
        }
      }
    },
    {
      "wait": 0.15
    },
    {
      "assert": "get_node('VillageSound').master_level==0 and get_node('VillageSound/Music').volume_db <= -80 and get_node('VillageSound/Rain').volume_db<=-80"
    },
    {
      "set": {
        "path": "HUD/Menus/Settings/Content/Scroll/Pages/Sound/MasterRow/Slider",
        "props": {
          "value": 0.5
        }
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_soundtrack",
        "args": [
          2
        ]
      }
    },
    {
      "wait": 1.2
    },
    {
      "assert": "get_node('VillageSound').current_track==2 and get_node('VillageSound/MusicNext').playing"
    },
    {
      "wait": 2.2
    },
    {
      "assert": "not get_node('VillageSound/MusicNext').playing"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_soundtrack",
        "args": [
          4
        ]
      }
    },
    {
      "wait": 1.2
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle').warp_mouse(get_node('HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/Menus/Settings/Content/Scroll/Pages/Sound/Toggle"
        }
      ]
    },
    {
      "assert": "not get_node('VillageSound/Music').playing and not get_node('VillageSound/MusicNext').playing"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "reset_sound"
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_tab",
        "args": [
          2
        ]
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "begin_rebind",
        "args": [
          "talk"
        ]
      }
    },
    {
      "input": [
        {
          "key": "Y"
        }
      ]
    },
    {
      "assert": "get_node('HUD/Menus').bindings.talk==89"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "begin_rebind",
        "args": [
          "move_forward"
        ]
      }
    },
    {
      "input": [
        {
          "key": "Y"
        }
      ]
    },
    {
      "assert": "get_node('HUD/Menus').conflict=='talk'"
    },
    {
      "input": [
        {
          "key": "Y"
        }
      ]
    },
    {
      "assert": "get_node('HUD/Menus').bindings.move_forward==89 and get_node('HUD/Menus').bindings.talk==87 and get_node('HUD/Hints/Row/Move/move_forward/Text').text=='Y'"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "reset_keys"
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_sensitivity",
        "args": [
          0.75
        ]
      }
    },
    {
      "assert": "abs(get_node('CameraRig').sensitivity-.00165)<.000001"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_graphics",
        "args": [
          1
        ]
      }
    },
    {
      "assert": "not get_node('Sun').shadow_enabled and get_viewport().msaa_3d==0"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_graphics",
        "args": [
          0
        ]
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_weather",
        "args": [
          4
        ]
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "get_node('WeatherRain').emitting"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_weather",
        "args": [
          3
        ]
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "not get_node('WeatherRain').emitting and get_node('Sun').light_energy < .1"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_language",
        "args": [
          1
        ]
      }
    },
    {
      "assert": "get_node('HUD/Hints/Row/Move/Caption').text=='\u79fb\u52d5'"
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_language",
        "args": [
          0
        ]
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_weather",
        "args": [
          1
        ]
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "set_sensitivity",
        "args": [
          1
        ]
      }
    },
    {
      "call": {
        "path": "HUD/Menus",
        "method": "close_menu"
      }
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/Actions/Buttons/Inventory').warp_mouse(get_node('HUD/Actions/Buttons/Inventory').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/Actions/Buttons/Inventory"
        }
      ]
    },
    {
      "assert": "get_node('HUD/Menus/Inventory').visible and get_node('HUD/Menus/Inventory/Content/Text').text.contains('Apples')"
    },
    {
      "input": [
        {
          "key": "Escape"
        }
      ]
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/VillageMap').warp_mouse(get_node('HUD/VillageMap').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/VillageMap"
        }
      ]
    },
    {
      "assert": "get_node('HUD/VillageMap').expanded and get_node('HUD/VillageMap').size==Vector2(1920,1080) and not get_node('HUD/Hints').visible"
    },
    {
      "input": [
        {
          "action": "move_right",
          "hold": 0.05
        }
      ]
    },
    {
      "assert": "get_node('HUD/VillageMap').selected_index != 0"
    },
    {
      "call": {
        "path": "HUD/VillageMap",
        "method": "select_destination",
        "args": [
          9
        ]
      }
    },
    {
      "eval": "get_tree().root.grab_focus()"
    },
    {
      "eval": "get_node('HUD/VillageMap/Expanded/Footer/Row/Go').warp_mouse(get_node('HUD/VillageMap/Expanded/Footer/Row/Go').size/2)"
    },
    {
      "wait": 0.15
    },
    {
      "input": [
        {
          "click_node": "HUD/VillageMap/Expanded/Footer/Row/Go"
        }
      ]
    },
    {
      "assert": "not get_node('HUD/VillageMap').expanded and not get_node('Player').controls_blocked"
    },
    {
      "assert": "get_node('WorldSurface').can_enter(Vector2(get_node('Player').position.x,get_node('Player').position.z))"
    },
    {
      "assert_no_errors": true
    }
  ]
}
